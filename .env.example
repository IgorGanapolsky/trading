# Safe local defaults
TRADING_ENV=paper
PAPER_TRADING=true
ACTIVE_STRATEGY_FAMILY=spy_put_credit
DRY_RUN=true

# Alpaca paper account. Leave blank until broker-backed checks are needed.
ALPACA_PAPER_TRADING_API_KEY=
ALPACA_PAPER_TRADING_API_SECRET=
# Compatibility aliases used by older explicit operator scripts.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional live-account reconciliation. These do not enable live submissions.
ALPACA_BROKERAGE_TRADING_API_KEY=
ALPACA_BROKERAGE_TRADING_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# Active risk gates
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_DAILY_STRUCTURES=1
MAX_DAILY_FILLS=20
MAX_POSITIONS=8
MIN_TRADE_AMOUNT=1.0
DAILY_INVESTMENT=10.0

# Local lessons memory. Keyword fallback works without optional vector packages.
LANCEDB_RAG=false
LANCEDB_REQUIRED=false
LANCEDB_AUTO_INDEX=false
LANCEDB_OFFLINE=true
RAG_WRITE_PROFILE=local
RAG_FAILURE_REFLECTION_WRITE=false
RAG_WEBHOOK_URL=
RAG_WEBHOOK_TOKEN=

# Optional model and research providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
FINNHUB_API_KEY=
MASSIVE_API_KEY=
FRED_API_KEY=
YOUTUBE_API_KEY=

# Optional OpenAI-compatible gateway
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
TETRATE_API_KEY=
PRIMARY_LLM_ROUTE=anthropic
SECONDARY_LLM_ROUTE=direct_openrouter
OPENROUTER_INPUT_OUTPUT_LOGGING_ENABLED=false

# Market data and cache bounds
YFINANCE_LOOKBACK_BUFFER_DAYS=35
YFINANCE_SECONDARY_LOOKBACK_DAYS=150
YFINANCE_MAX_RETRIES=3
YFINANCE_INITIAL_BACKOFF_SECONDS=1.0
ALPACA_MAX_RETRIES=3
ALPACA_INITIAL_BACKOFF_SECONDS=2.0
MARKET_DATA_CACHE_DIR=data/cache/market_data
CACHE_TTL_SECONDS=21600
CACHE_MAX_AGE_DAYS=7

# Optional observability and alerts
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
ENVIRONMENT=development
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CEO_EMAIL=
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# Mercury and dividend-growth adapters are disabled unless explicitly enabled.
MERCURY_API_TOKEN=
MERCURY_ACCOUNT_ID=
MERCURY_RECIPIENT_ID=
MERCURY_LIVE_TRANSFERS_ENABLED=0
MERCURY_TRANSFER_LEDGER=data/audit/mercury_broker_transfers.jsonl
DIVIDEND_GROWTH_ALPACA_API_KEY=
DIVIDEND_GROWTH_ALPACA_API_SECRET=
DIVIDEND_GROWTH_ALPACA_ENABLED=0
DIVIDEND_GROWTH_ALPACA_PAPER=1
DIVIDEND_GROWTH_FILL_TIMEOUT_SECONDS=30

# Income-loop defaults; no transfer occurs while adapters above are disabled.
MONTHLY_AFTER_TAX_TARGET_USD=1000.0
DEFAULT_QUALIFIED_DIVIDEND_TAX_RATE=0.15
DEFAULT_LONG_TERM_CAPITAL_GAINS_TAX_RATE=0.15
DEFAULT_SHORT_TERM_TAX_RATE=0.37
BANK_BUFFER_USD=500.0
PROFIT_RETURN_THRESHOLD_USD=50.0
INCOME_LOOP_TAX_RATE=0.15
